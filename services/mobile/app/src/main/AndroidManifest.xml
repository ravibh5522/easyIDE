<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloading the Linux rootfs tarball during environment provisioning. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Onboarding's one-tap battery-optimisation exemption dialog, so the sandbox keeps
      running with the screen off. Play restricts this permission to apps whose core
      function needs it; a terminal-hosting IDE is the intended use, but check the
      policy before a Play release. POST_NOTIFICATIONS comes from :sandbox-runtime, whose
      foreground service needs it.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".EasyIdeApplication"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.EasyIde"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EasyIde.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- `easyide-ext dev` over adb (docs/extension-sdk/lld/cli.md sec 5.7). Explicit
             broadcasts only; DUMP is held by the adb shell user, never by an installable app,
             so no other app can trigger a reload. Acts only with extensions.developerMode on. -->
        <receiver
            android:name=".extensions.dev.DevReloadReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
