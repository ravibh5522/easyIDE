<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window/splash background shown before Compose draws its first frame.
      Must equal the editor surface in ui/theme/EditorColors.kt
      (LightEditorColors.background here, DarkEditorColors.background in
      values-night) so the hand-off to Compose is invisible. XML is the only
      place the window can read a color from before any Kotlin runs.
    -->
    <color name="window_background">#FFFFFFFF</color>
</resources>
