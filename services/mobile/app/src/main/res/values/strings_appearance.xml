<resources>
    <string name="setting_accent_title">Accent colour</string>
    <string name="setting_accent_desc">"theme", "wallpaper" (Android 12+) or a hex colour such as #FF8A3D. Adjusted when it would be hard to read.</string>
    <string name="setting_density_title">Density</string>
    <string name="setting_density_desc">Spacing and row heights. Touch targets never drop below 44 dp.</string>
    <string name="setting_corners_title">Corners</string>
    <string name="setting_corners_desc">How round buttons, cards, dialogs and tags are.</string>
    <string name="setting_ui_scale_title">Interface scale (%)</string>
    <string name="setting_ui_scale_desc">Scales the interface and its text together. The editor font size is separate.</string>
    <string name="setting_font_pairing_title">Interface font</string>
    <string name="setting_font_pairing_desc">Geist with Geist Mono, Geist Mono for all chrome, or the system fonts.</string>
    <string name="setting_chrome_contrast_title">Chrome contrast</string>
    <string name="setting_chrome_contrast_desc">Strength of dividers and secondary text, separate from the high contrast theme.</string>
    <string name="setting_motif_title">Block motif</string>
    <string name="setting_motif_desc">How much the cursor block and prompt glyph appear in the interface.</string>
    <string name="setting_cursor_blink_title">Cursor blink</string>
    <string name="setting_cursor_blink_desc">Blink the cursor block. Always solid when motion is reduced or a screen reader is on.</string>
    <string name="setting_reduce_motion_title">Reduce motion</string>
    <string name="setting_reduce_motion_desc">Turn every animation off. System follows the Android setting.</string>
    <string name="setting_haptics_title">Haptics</string>
    <string name="setting_haptics_desc">Vibration feedback for keys, toggles and drags.</string>
    <string name="setting_icon_style_title">Icon set</string>
    <string name="setting_icon_style_desc">easyIDE glyphs or Material icons.</string>
    <string name="setting_handedness_title">Handedness</string>
    <string name="setting_handedness_desc">Mirrors sheets and dialog buttons for left-handed use.</string>

