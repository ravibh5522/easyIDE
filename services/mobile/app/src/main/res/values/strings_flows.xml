<!-- Onboarding, Install Linux and New project (docs/ui-redesign/screens.md 6-7, identity.md 9).
     Terse, sentence case, no exclamation marks. No string here calls proot or chroot an
     isolation boundary: both are single-tenant. "Get started" is also the baseline-profile
     selector (BaselineProfileGenerator.ONBOARDING_CONTINUE): change both together. -->
<resources>
    <!-- Onboarding: steps -->
    <string name="onboarding_title">Code on this device</string>
    <string name="onboarding_body">Editor, terminal, git and a Linux sandbox. Everything runs on-device and works offline.</string>
    <string name="onboarding_continue">Get started</string>
    <string name="onboarding_footnote">Theme and environments live in Settings.</string>
    <string name="onboarding_next">Continue</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_skip_environment">Skip for now</string>
    <string name="onboarding_finish">Start using easyIDE</string>
    <string name="onboarding_battery_title">Keep the sandbox running</string>
    <string name="onboarding_battery_body">Android pauses background apps to save power. That stops a dev server or a long build when the screen turns off. Exempt easyIDE from battery optimisation.</string>
    <string name="onboarding_battery_allow">Allow</string>
    <string name="onboarding_battery_allowed">Allowed. Android will not pause easyIDE to save power.</string>
    <string name="onboarding_battery_not_allowed">Not allowed. Change it later in Android settings.</string>
    <string name="onboarding_notifications_title">Show a notification while it runs</string>
    <string name="onboarding_notifications_body">Android requires a visible notification while the sandbox runs in the background and while Linux downloads. Without the permission it cannot be shown, and Android may stop the work sooner.</string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_allowed">Allowed. The notification can be shown.</string>
    <string name="onboarding_notifications_not_allowed">Not allowed.</string>
    <string name="onboarding_notifications_refused">Notifications are off. Turn them on in Android settings, or skip.</string>
    <string name="onboarding_notifications_open_settings">Open settings</string>
    <string name="onboarding_environment_title">Install Linux</string>
    <string name="onboarding_done_title">Ready.</string>
    <string name="onboarding_done_battery_on">Runs in the background</string>
    <string name="onboarding_done_battery_off">Background running is off. Android may pause the sandbox with the screen off.</string>
    <string name="onboarding_done_notifications_on">Notifications allowed</string>
    <string name="onboarding_done_notifications_off">Notifications are off. Turn them on in Android settings.</string>
    <string name="onboarding_done_linux_on">Linux installed</string>
    <string name="onboarding_done_linux_off">Linux not installed. Home offers to install it.</string>
