    <string name="setup_fail_storage_advice">Android refused a write to app storage. Try again; if it repeats, restart the app.</string>
    <string name="setup_fail_unsupported_title">Device not supported</string>
    <string name="setup_fail_unsupported_advice">The Linux runtime is built for 64-bit ARM and x86-64 devices only.</string>
    <string name="setup_fail_setup_title">Package install failed</string>
    <string name="setup_fail_setup_advice">Linux is installed, but the preset\'s packages are not. Try again, or pick the plain Ubuntu preset and install packages from the terminal.</string>
    <string name="setup_fail_unknown_title">Install failed</string>
    <string name="setup_fail_unknown_advice">Try again. If it keeps failing, the details below help when reporting it.</string>

