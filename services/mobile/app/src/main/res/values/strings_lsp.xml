<?xml version="1.0" encoding="utf-8"?>
<!-- Language-server settings and LSP editor UI. Kept apart from strings.xml so the LSP
     integration's strings are reviewed and merged as one unit. -->
<resources>
    <string name="settings_category_language_servers">Language servers</string>

    <string name="setting_lsp_enabled_title">Language servers</string>
    <string name="setting_lsp_enabled_desc">Start language servers for open files (completion, diagnostics, navigation).</string>
    <string name="setting_lsp_servers_title">Custom and overridden servers</string>
    <string name="setting_lsp_servers_desc">lsp.servers: JSON object keyed by server key. Override a contributed server (e.g. {\"easyide.python/pyright\": {\"enabled\": false}}) or add one with languages and command.</string>
    <string name="setting_lsp_trace_title">Protocol trace</string>
    <string name="setting_lsp_trace_desc">Record JSON-RPC traffic in each server\'s log.</string>
    <string name="setting_lsp_global_budget_title">Total memory budget (MB)</string>
    <string name="setting_lsp_global_budget_desc">Servers are stopped, least recently used first, when together they use more.</string>
    <string name="setting_lsp_default_budget_title">Per-server memory budget (MB)</string>
    <string name="setting_lsp_default_budget_desc">A server above its budget is restarted once, then stopped.</string>
    <string name="setting_lsp_max_servers_title">Maximum running servers</string>
    <string name="setting_lsp_max_servers_desc">Starting one more stops the least recently used.</string>
    <string name="setting_lsp_idle_shutdown_title">Idle shutdown (seconds)</string>
    <string name="setting_lsp_idle_shutdown_desc">A server with no open files stops after this long.</string>
    <string name="setting_lsp_startup_timeout_title">Startup timeout (seconds)</string>
    <string name="setting_lsp_startup_timeout_desc">A server that does not initialize in time is marked failed.</string>
    <string name="setting_lsp_max_retries_title">Restart attempts</string>
    <string name="setting_lsp_max_retries_desc">Crashes within five minutes before a server stays failed.</string>
    <string name="setting_lsp_backoff_title">Restart backoff (ms)</string>
    <string name="setting_lsp_backoff_desc">Wait before the first restart; doubles with each crash.</string>
    <string name="setting_lsp_change_debounce_title">Change debounce (ms)</string>
    <string name="setting_lsp_change_debounce_desc">Typing pause before edits are sent to servers.</string>
    <string name="setting_lsp_request_timeout_title">Request timeout (ms)</string>
    <string name="setting_lsp_request_timeout_desc">Unanswered requests are dropped silently after this.</string>

    <string name="setting_quick_suggestions_title">Suggestions while typing</string>
    <string name="setting_quick_suggestions_desc">editor.quickSuggestions: true, false, or {\"other\", \"comments\", \"strings\"} booleans.</string>
    <string name="setting_quick_suggestions_delay_title">Suggestion delay (ms)</string>
    <string name="setting_quick_suggestions_delay_desc">Typing pause before suggestions are requested.</string>
    <string name="setting_suggest_trigger_title">Suggest on trigger characters</string>
    <string name="setting_suggest_trigger_desc">Open suggestions after characters such as a dot.</string>
    <string name="setting_accept_on_enter_title">Accept suggestion on Enter</string>
    <string name="setting_accept_on_enter_desc">Smart accepts only when it changes more than what you typed.</string>
    <string name="setting_parameter_hints_title">Parameter hints</string>
    <string name="setting_parameter_hints_desc">Show the signature of the call being typed.</string>
    <string name="setting_hover_enabled_title">Hover information</string>
    <string name="setting_hover_enabled_desc">Show symbol information on long-press or mouse hover.</string>
    <string name="setting_hover_delay_title">Hover delay (ms)</string>
    <string name="setting_hover_delay_desc">Mouse rest time before hover information appears.</string>
    <string name="setting_inlay_hints_title">Inlay hints</string>
    <string name="setting_inlay_hints_desc">Types and parameter names shown at line ends.</string>
    <string name="setting_semantic_highlighting_title">Semantic highlighting</string>
    <string name="setting_semantic_highlighting_desc">Colours from the language server over the grammar\'s colours.</string>
    <string name="setting_code_lens_title">Code lens</string>
    <string name="setting_code_lens_desc">Actions such as run or references, shown as a gutter icon; tap it to list them.</string>
    <string name="setting_format_on_save_title">Format on save</string>
    <string name="setting_format_on_save_desc">Format with the language server before writing the file.</string>
    <string name="setting_format_on_type_title">Format on type</string>
    <string name="setting_format_on_type_desc">Let the server reformat after characters it asks for.</string>
    <string name="setting_default_formatter_title">Default formatter</string>
    <string name="setting_default_formatter_desc">Server key that formats when several can; empty picks the highest priority.</string>
    <string name="setting_code_actions_on_save_title">Code actions on save</string>
    <string name="setting_code_actions_on_save_desc">editor.codeActionsOnSave: {\"source.organizeImports\": true} runs those kinds before saving.</string>
    <string name="setting_lightbulb_title">Code action lightbulb</string>
    <string name="setting_lightbulb_desc">Show a lightbulb in the gutter when fixes are available.</string>
    <string name="setting_occurrences_title">Highlight occurrences</string>
    <string name="setting_occurrences_desc">Highlight every use of the symbol at the caret.</string>
    <string name="setting_min_severity_title">Minimum diagnostic severity</string>
    <string name="setting_min_severity_desc">Less severe diagnostics are hidden everywhere.</string>
    <string name="setting_diagnostics_gutter_title">Diagnostics in gutter</string>
    <string name="setting_diagnostics_gutter_desc">Error and warning icons next to line numbers.</string>
    <string name="setting_diagnostics_squiggles_title">Diagnostic squiggles</string>
    <string name="setting_diagnostics_squiggles_desc">Underline the code a diagnostic is about.</string>
    <string name="setting_diagnostics_ignore_title">Ignored diagnostic sources</string>
    <string name="setting_diagnostics_ignore_desc">One source per line (e.g. Pyright); their diagnostics are hidden.</string>

