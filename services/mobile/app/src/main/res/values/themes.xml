<resources>
    <!--
      Minimal platform theme required as the Activity's window theme before Compose
      takes over. All real theming (colors, typography, the six-theme system) lives
      in Kotlin under ui/theme per docs/design-system/arch.md - this XML theme is
      intentionally not the source of truth for app colors. Its only job is a
      window background that matches the first Compose frame, so there is no
      flash. The parent flips with the system night mode via values-night.
    -->
    <style name="Theme.EasyIde" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      Launch theme: holds the splash until MainActivity has read the theme and
      onboarding preferences, then swaps to Theme.EasyIde. The background is the window
      colour, so the splash hands over to the first frame without a flash; the mark's block
      blinks once (ic_splash_animated).
    -->
    <style name="Theme.EasyIde.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.EasyIde</item>
    </style>
</resources>
