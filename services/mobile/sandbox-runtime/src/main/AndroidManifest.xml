<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The sandbox process tree must survive app backgrounding, which requires a
      foreground service - see docs/sandbox-runtime/arch.md SS4 "App lifecycle
      state machine". dataSync is the closest standard type; revisit against
      Play policy before shipping (tracked in the sandbox-runtime tracker).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".service.SandboxForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
