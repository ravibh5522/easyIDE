{
  "viewSchema": 1,
  "state": { "containers": [], "runningCount": 0, "query": "" },
  "root": {
    "type": "column", "gap": "s",
    "children": [
      { "type": "search", "hint": "Filter containers", "bind": "query" },
      {
        "type": "list", "bind": "containers", "key": "id", "query": "query", "filterFields": ["name", "image"],
        "item": {
          "type": "row", "align": "center", "gap": "s", "open": "ext://acme.docker/container/{id}",
          "children": [
            { "type": "statusDot", "tone": "success", "label": "running", "when": "state == running" },
            { "type": "statusDot", "tone": "neutral", "label": "stopped", "when": "state != running" },
            { "type": "column", "weight": 1, "children": [
              { "type": "text", "value": "{name}", "role": "body" },
              { "type": "text", "value": "{image} {status}", "role": "mono" }
            ] },
            { "type": "iconButton", "icon": "stop", "label": "Stop {name}", "when": "state == running", "action": "acme.docker.stop", "args": { "id": "{id}" },
              "confirm": { "title": "Stop {name}?", "body": "The container stops; its state is kept.", "destructive": true } },
            { "type": "iconButton", "icon": "play", "label": "Start {name}", "when": "state != running", "action": "acme.docker.start", "args": { "id": "{id}" } }
          ]
        },
        "empty": { "type": "emptyState", "message": "No containers" }
      }
    ]
  }
}
