{
  "name": "wasm-word-count",
  "publisher": "easyide-samples",
  "version": "0.1.0",
  "displayName": "Word Count (WASM sample)",
  "description": "Sample L2 extension: counts the words in the active editor from a Rust WASM module.",
  "license": "Apache-2.0",
  "engines": { "easyide": "^0.3.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:wasm-word-count.count"],
  "contributes": {
    "commands": [ { "command": "wasm-word-count.count", "title": "Count Words", "category": "Word Count" } ],
    "menus": { "commandPalette": [ { "command": "wasm-word-count.count", "when": "editorLangId" } ] }
  },
  "easyide": {
    "capabilities": ["fs.project(read)"],
    "wasm": { "module": "./wasm/main.wasm", "abi": 1, "memoryMb": 16 }
  }
}
